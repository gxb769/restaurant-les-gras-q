# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values before running/building.
# .env.local is gitignored — never commit real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# Formspree form ID for the reservation modal
# 1. Sign up at https://formspree.io (free tier = 50 submissions/month)
# 2. Create a new form → copy the 8-character ID from the endpoint URL
#    e.g. https://formspree.io/f/xpwzgakq  →  ID = xpwzgakq
# 3. Set the value below, then rebuild the site (npm run build)
#
# NEXT_PUBLIC_ prefix is required: this site uses static export (output:'export')
# so env vars are inlined at build time — only NEXT_PUBLIC_ vars reach the browser.
NEXT_PUBLIC_FORMSPREE_ID=your_form_id_here
